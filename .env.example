# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Режим запуска: polling (локально/дебаг) или webhook (на хостинге Railway/Render)
RUN_MODE=poll

# Для webhook (на хостинге):
# WEBHOOK_URL=https://имя-приложения.up.railway.app/webhook

# Белый список сотрудников (их Telegram ID, через запятую). Пусто = бот открыт всем.
ALLOWED_IDS=

# Порт для вебхука (на Railway/Render подставляется автоматически через PORT)
PORT=8080